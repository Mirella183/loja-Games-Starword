#!/bin/bash
# Organiza o repositório StarWord em pastas dentro de pastas.
# Como usar: copie este arquivo para a raiz do repositório clonado e rode:
#   bash organizar.sh
# Depois envie para o GitHub:
#   git commit -m "Organiza arquivos em pastas"
#   git push

set -e

# 1. Criar as pastas
mkdir -p "01-Documentacao/Projeto"
mkdir -p "01-Documentacao/Defesa"
mkdir -p "02-Banco-de-Dados/Diagramas"
mkdir -p "02-Banco-de-Dados/Modelagem"
mkdir -p "03-Design/Prototipos"
mkdir -p "03-Design/Esbocos"
mkdir -p "03-Design/Identidade-Visual/Logos"
mkdir -p "03-Design/Identidade-Visual/Cores"
mkdir -p "03-Design/Identidade-Visual/Tipografia"

# 2. Mover os arquivos
git mv "Projeto Starword (1).pdf" "01-Documentacao/Projeto/"

for f in Defesa\ StarWord_*; do
  git mv "$f" "01-Documentacao/Defesa/"
done

git mv "Diagrama_DER.pdf" "02-Banco-de-Dados/Diagramas/"
git mv "BD-starword.png" "02-Banco-de-Dados/Modelagem/"

git mv "Figma.pdf" "03-Design/Prototipos/"
git mv "Excalidraw.starword" "03-Design/Esbocos/"

git mv "Logo.jpeg" "03-Design/Identidade-Visual/Logos/"
git mv "Logotipo.jpeg" "03-Design/Identidade-Visual/Logos/"
git mv "Paleta de Cores.pdf" "03-Design/Identidade-Visual/Cores/"
git mv "Tipografia" "03-Design/Identidade-Visual/Tipografia/"

echo "Pronto! Confira com 'git status' e depois faça o commit e o push."
